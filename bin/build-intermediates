#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Build a journal's INTERMEDIATES — the portable form of what it has cut, for whoever
# publishes it.
#
# WHAT AN INTERMEDIATE IS FOR. An outer site that mounts this journal must not have to know
# how this journal runs its shop. An area is free to reach for its own plugins and its own
# esoteric layouts on the way to deciding what an issue is; what it hands upward has to be
# something anything can read. So this writes an INERT artifact: front matter plus plain
# markdown, no template syntax at all. Nothing needs to be trusted to render it, and the
# JavaScript client reads it as readily as Jekyll does.
#
# IT CARRIES THE PIECES TOO. The outer site bakes the issues, and to do that it has to see
# the letters — so each cited piece is written out beside the arrangement, at the path its url
# already names. This is a PREBUILT ARTIFACT that stays in this repository: the text has not
# left the network it was already in, it is simply here in a form something else can read
# without knowing how this journal is built.
#
# What travels is the piece reduced: its OWN front matter (title, author, date, tags — the
# keys that describe the piece and travel with it anywhere) and its body. What is dropped are
# the CLAIMS ON A URL SPACE — redirect_from, redirect_to, permalink — which belong to whichever
# site first published the piece and are meaningless anywhere else. Nothing here was ever
# moved, so there is nothing to redirect.
#
# THE PIN IS THE POINT. Each piece is recorded with the commit its submodule is pinned at,
# read from the tree rather than the working checkout. That single field does three jobs:
# it says which exact words ran, so a third party's rendering is checkable against ours; it
# makes staleness visible when an outer build picks up an intermediate older than its
# source; and it is the same pin that makes publishing, editing, and withdrawal one
# mechanism rather than three.
#
# Run from the SITE root — the repo wearing the glove, never this engine.
#
#   bin/build-intermediates [--issues DIR] [--out DIR] [--journal DIR]

require "yaml"
require "date"
require "fileutils"
require "shellwords"

opts = { issues: "issues", out: "_intermediates", journal: nil }
args = ARGV.dup
until args.empty?
  case (a = args.shift)
  when "--issues"  then opts[:issues]  = args.shift
  when "--out"     then opts[:out]     = args.shift
  when "--journal" then opts[:journal] = args.shift
  when "--help", "-h"
    puts File.read(__FILE__).lines.grep(/^#/).join
    exit 0
  else
    abort "build-intermediates: unknown argument #{a}"
  end
end

def site_config
  File.exist?("_config.yml") ? (YAML.safe_load(File.read("_config.yml"), permitted_classes: [Date]) || {}) : {}
rescue Psych::Exception
  {}
end

config = site_config
mount = opts[:journal] || config["journal"] || "journal"
area  = config["civic_node"].to_s
title = config["title"].to_s

# An issue is keyed by the PERIOD IT COVERS. The day it was cut is a separate fact and
# travels in `cut:`, so an identifier never has to stand in for a claim.
ISSUE_KEY = /\A(\d{4}-\d{2})\.md\z/

def front_matter(path)
  src = File.read(path)
  m = /\A---\r?\n(.*?)\r?\n---\r?\n?/m.match(src)
  return {} unless m

  YAML.safe_load(m[1], permitted_classes: [Date]) || {}
rescue Psych::Exception => e
  warn "build-intermediates: #{path}: unreadable front matter (#{e.message})"
  {}
end

# The commit a path is pinned at, read from the TREE rather than the working checkout — the
# recorded pin is the citation, and a dirty checkout must not be able to change what we say
# ran. Returns nil when the path is not a pinned submodule.
def pinned_commit(path)
  out = `git ls-tree HEAD -- #{path.shellescape} 2>/dev/null`
  return nil if out.strip.empty?

  mode, type, sha, _ = out.split
  (mode == "160000" && type == "commit") ? sha : nil
end

def submodule_url(path)
  url = `git config --file .gitmodules --get submodule.#{path.shellescape}.url 2>/dev/null`.strip
  url.empty? ? nil : url
end

# A cited url is a URL-space fact; the on-disk path is ours. `/journal/beat/piece/` sits at
# `journal/beat/piece` because this engine mounts content where it serves it.
def path_for(url, mount)
  rel = url.to_s.sub(%r{\A/}, "").sub(%r{/\z}, "")
  rel = rel.sub(%r{\A#{Regexp.escape(mount)}/}, "")
  rel.empty? ? nil : File.join(mount, rel)
end

# Front matter keys that are CLAIMS ON A URL SPACE rather than descriptions of a piece. They
# belong to whichever site first published it; a mounting site never had those addresses, so
# honouring them would mint pages at another site's URLs — and two journals citing the same
# piece would both claim the same ones.
URL_CLAIMS = %w[redirect_from redirect_to permalink].freeze

# Write one cited piece into the artifact, at the path its url already names, so the tier above
# can copy the tree straight into its own served space.
def write_piece(url, path, out)
  src = File.join(path, "index.md")
  return warn("  #{url}: no index.md in the pin; not carried") unless File.exist?(src)

  raw = File.read(src)
  m = /\A---\r?\n(.*?)\r?\n---\r?\n?/m.match(raw)
  front = m ? (YAML.safe_load(m[1], permitted_classes: [Date]) || {}) : {}
  body = m ? raw[m[0].length..] : raw

  URL_CLAIMS.each { |k| front.delete(k) }
  # The mounting site decides the layout. A piece must not have to know who is publishing it.
  front.delete("layout")

  # A CARRIED PIECE MAY NOT CONTAIN TEMPLATE SYNTAX, and this refuses rather than warns.
  #
  # Not for portability — for what the syntax can reach. A mounting site builds what it is
  # handed, and a piece's `{% include %}`, `{% raw_include %}` or any other tag is evaluated in
  # THAT site's build, against ITS includes, ITS plugins, ITS filesystem. A contributor writes
  # the letter; they do not get to run a step in the newsroom's build. No browser is involved,
  # so no content policy reaches this: it happens before anything is served.
  #
  # This is the ejection gate doing its job. A piece is worked on in its author's own
  # repository and ejected when it is ready; template syntax in an ejected piece is something
  # an editor fixes there, where an editor is present, rather than something the tier above
  # discovers unattended. Failing here is the whole point — the alternative is carrying it and
  # hoping whoever mounts it is careful.
  if (found = body.scan(/\{\{[^}]*\}\}|\{%-?\s*\w+/).uniq.first(3)).any?
    abort <<~REFUSED
      build-intermediates: refusing to carry #{url}
        It contains template syntax: #{found.join(", ")}
        A mounting site evaluates that in ITS build, against ITS includes and plugins. Remove it
        from the piece — a letter is prose, and anything it needs rendering is the journal's to
        render around it.
    REFUSED
  end

  dest = File.join(out, url.sub(%r{\A/}, "").sub(%r{/\z}, ""), "index.md")
  FileUtils.mkdir_p(File.dirname(dest))
  File.write(dest, "#{front.to_yaml}---\n\n#{body.sub(/\A\n+/, "")}")

end

FileUtils.mkdir_p(opts[:out])

issue_files = Dir.children(opts[:issues]).select { |f| ISSUE_KEY.match?(f) }.sort
if issue_files.empty?
  warn "build-intermediates: no issues in #{opts[:issues]}/ — nothing to hand upward yet"
end

built = []
issue_files.each do |file|
  key = ISSUE_KEY.match(file)[1]
  data = front_matter(File.join(opts[:issues], file))

  pieces = Array(data["pieces"]).map do |entry|
    url = entry["url"].to_s
    path = path_for(url, mount)
    sha = path ? pinned_commit(path) : nil
    write_piece(url, path, opts[:out]) if path && sha
    {
      "url" => url,
      "title" => entry["title"].to_s,
      "author" => entry["author"].to_s,
      # `source` absent means the citation is not pinned here any more — a withdrawal seen
      # from upstream. The consumer renders it as withdrawn rather than dropping it, because
      # an issue that quietly loses a letter misrepresents its own history.
      "source" => sha,
      "source_repo" => path ? submodule_url(path) : nil
    }.compact
  end

  meta = {
    "issue" => key,
    "title" => data["title"].to_s.empty? ? "#{title} — #{key}" : data["title"].to_s,
    "area" => area,
    "cut" => data["cut"].to_s,
    "layout" => data["layout"].to_s.empty? ? nil : data["layout"].to_s,
    "pieces" => pieces
  }.compact

  # The body is a plain list and nothing else: an inert rendering of the same arrangement,
  # so a reader with no build at all still sees what ran.
  body = pieces.map do |p|
    line = +"- [#{p['title']}](#{p['url']})"
    line << " — #{p['author']}" unless p["author"].to_s.empty?
    line << " *(withdrawn)*" unless p["source"]
    line
  end.join("\n")
  body = "*No letters ran in this issue.*" if body.empty?

  File.write(File.join(opts[:out], "#{key}.md"), "#{meta.to_yaml}---\n\n#{body}\n")
  built << key
  puts "  #{key}  #{pieces.size} piece(s), #{pieces.count { |p| p['source'] }} pinned"
end

# The entry point: a light indirection to the newest issue that has been cut. A consumer asks
# for one stable address and never has to know this journal's cut dates or numbering. It is
# an indirection rather than a copy so that an issue has exactly one rendering — the one it
# was cut with — and a redesign years from now cannot quietly turn a past issue into
# something it never was.
latest = built.last
entry = {
  "entry_point" => true,
  "area" => area,
  "issue" => latest,
  "title" => latest ? "#{title} — current issue" : "#{title} — no issue yet"
}.compact
entry_body = latest ? "The current issue is [#{latest}](#{latest}.md)." : "*No issue has been cut yet.*"
File.write(File.join(opts[:out], "current.md"), "#{entry.to_yaml}---\n\n#{entry_body}\n")

# An intermediate is INERT. Anything that has to be rendered to be safe is not portable, and
# the failure would be silent — a blank page rather than an error. Cheaper to refuse here.
# The files this tool AUTHORS must be inert — anything that has to be rendered to be safe is
# not portable, and the failure would be a blank page rather than an error. A carried piece is
# not one of those: it is a contributor's Jekyll source and may legitimately hold Liquid, which
# is warned about above rather than refused here.
offenders = Dir.glob(File.join(opts[:out], "*.md")).select { |f| File.read(f).match?(/\{\{|\{%/) }
unless offenders.empty?
  warn "build-intermediates: template syntax in an intermediate, which must be inert:"
  offenders.each { |f| warn "  #{f}" }
  exit 1
end

puts "build-intermediates: #{built.size} issue(s) + entry point -> #{opts[:out]}/"
